package controller

import (
	"context"
	"fmt"

	"k8s.io/apimachinery/pkg/api/errors"
	"k8s.io/apimachinery/pkg/runtime"
	"k8s.io/apimachinery/pkg/util/intstr"
	ctrl "sigs.k8s.io/controller-runtime"
	"sigs.k8s.io/controller-runtime/pkg/client"
	"sigs.k8s.io/controller-runtime/pkg/log"

	appsv1 "k8s.io/api/apps/v1"
	corev1 "k8s.io/api/core/v1"
	networkingv1 "k8s.io/api/networking/v1"

	kubesharkv1beta1 "kubeshark-operator/api/v1beta1"
)

// KubesharkReconciler reconciles a Kubeshark object
type KubesharkReconciler struct {
	client.Client
	Scheme *runtime.Scheme
}

//+kubebuilder:rbac:groups=kubeshark.opstreelabs.in,resources=kubesharks,verbs=get;list;watch;create;update;patch;delete
//+kubebuilder:rbac:groups=kubeshark.opstreelabs.in,resources=kubesharks/status,verbs=get;update;patch
//+kubebuilder:rbac:groups=kubeshark.opstreelabs.in,resources=kubesharks/finalizers,verbs=update

// Reconcile is part of the main Kubernetes reconciliation loop which aims to
// move the current state of the cluster closer to the desired state.
// Reconcile performs the reconciliation loop
func (r *KubesharkReconciler) Reconcile(ctx context.Context, req ctrl.Request) (ctrl.Result, error) {
	logger := log.FromContext(ctx)

	// Fetch the Kubeshark instance
	cr := &kubesharkv1beta1.Kubeshark{}
	err := r.Client.Get(ctx, req.NamespacedName, cr)
	if err != nil {
		if errors.IsNotFound(err) {
			// CR was deleted, handle cleanup if necessary
			logger.Info("Kubeshark resource not found. Ignoring since object must be deleted.")
			return ctrl.Result{}, nil
		}
		// Error reading the object - requeue the request.
		return ctrl.Result{}, err
	}

	// Define labels to be used by all resources managed by this CR
	labels := map[string]string{
		"app.kubernetes.io/name":       "kubeshark",
		"app.kubernetes.io/instance":   cr.Name,
		"app.kubernetes.io/managed-by": "kubeshark-operator",
	}

	// Reconcile ConfigMap
	hubConfigMapName := getOrDefaultString(cr.Spec.HubConfigMapName, "kubeshark-hub-config")
	hubConfigMap := &corev1.ConfigMap{}
	err = r.Client.Get(ctx, client.ObjectKey{Namespace: cr.Namespace, Name: hubConfigMapName}, hubConfigMap)
	if err != nil && errors.IsNotFound(err) {
		// Create ConfigMap if not found
		hubConfigMap = r.createHubConfigMap(cr, labels)
		if err := r.Client.Create(ctx, hubConfigMap); err != nil {
			return ctrl.Result{}, err
		}
		logger.Info(fmt.Sprintf("Created ConfigMap %s", hubConfigMap.Name))
	} else if err != nil {
		return ctrl.Result{}, err
	}

	// Reconcile Deployment
	hubDeploymentName := getOrDefaultString(cr.Spec.HubDeploymentName, "kubeshark-hub-deployment")
	hubDeployment := &appsv1.Deployment{}
	err = r.Client.Get(ctx, client.ObjectKey{Namespace: cr.Namespace, Name: hubDeploymentName}, hubDeployment)
	if err != nil && errors.IsNotFound(err) {
		// Create Deployment if not found
		hubDeployment = r.createHubDeployment(cr, labels)
		if err := r.Client.Create(ctx, hubDeployment); err != nil {
			return ctrl.Result{}, err
		}
		logger.Info(fmt.Sprintf("Created Deployment %s", hubDeployment.Name))
	} else if err != nil {
		return ctrl.Result{}, err
	}

	// Reconcile Service
	hubServiceName := getOrDefaultString(cr.Spec.HubServiceName, "kubeshark-hub-service")
	hubService := &corev1.Service{}
	err = r.Client.Get(ctx, client.ObjectKey{Namespace: cr.Namespace, Name: hubServiceName}, hubService)
	if err != nil && errors.IsNotFound(err) {
		// Create Service if not found
		hubService = r.createHubService(cr, labels)
		if err := r.Client.Create(ctx, hubService); err != nil {
			return ctrl.Result{}, err
		}
		logger.Info(fmt.Sprintf("Created Service %s", hubService.Name))
	} else if err != nil {
		return ctrl.Result{}, err
	}

	// Reconcile Ingress
	hubIngressName := "kubeshark-hub-ingress"
	hubIngress := &networkingv1.Ingress{}
	err = r.Client.Get(ctx, client.ObjectKey{Namespace: cr.Namespace, Name: hubIngressName}, hubIngress)
	if err != nil && errors.IsNotFound(err) {
		// Create Ingress if not found
		hubIngress = r.createHubIngress(cr, labels)
		if err := r.Client.Create(ctx, hubIngress); err != nil {
			return ctrl.Result{}, err
		}
		logger.Info(fmt.Sprintf("Created Ingress %s", hubIngress.Name))
	} else if err != nil {
		return ctrl.Result{}, err
	}

	// Other resource reconciliations follow the same pattern...

	return ctrl.Result{}, nil
}

func (r *KubesharkReconciler) createHubConfigMap(cr *kubesharkv1beta1.Kubeshark, labels map[string]string) *corev1.ConfigMap {
	return &corev1.ConfigMap{
		ObjectMeta: ctrl.ObjectMeta{
			Name:      getOrDefaultString(cr.Spec.HubConfigMapName, "kubeshark-hub-config"),
			Namespace: cr.Namespace,
			Labels:    labels,
		},
		Data: cr.Spec.HubConfigMapData,
	}
}

func (r *KubesharkReconciler) createHubDeployment(cr *kubesharkv1beta1.Kubeshark, labels map[string]string) *appsv1.Deployment {
	return &appsv1.Deployment{
		ObjectMeta: ctrl.ObjectMeta{
			Name:      getOrDefaultString(cr.Spec.HubDeploymentName, "kubeshark-hub-deployment"),
			Namespace: cr.Namespace,
			Labels:    labels,
		},
		Spec: appsv1.DeploymentSpec{
			Replicas: getOrDefaultInt(cr.Spec.HubReplicas, 1),
			Template: corev1.PodTemplateSpec{
				ObjectMeta: ctrl.ObjectMeta{
					Labels: labels,
				},
				Spec: corev1.PodSpec{
					Containers: []corev1.Container{
						{
							Name:  "kubeshark-hub",
							Image: cr.Spec.HubImage,
							Ports: cr.Spec.HubContainerPorts,
						},
					},
				},
			},
		},
	}
}

func (r *KubesharkReconciler) createHubService(cr *kubesharkv1beta1.Kubeshark, labels map[string]string) *corev1.Service {
	return &corev1.Service{
		ObjectMeta: ctrl.ObjectMeta{
			Name:      getOrDefaultString(cr.Spec.HubServiceName, "kubeshark-hub-service"),
			Namespace: cr.Namespace,
			Labels:    labels,
		},
		Spec: corev1.ServiceSpec{
			Ports: []corev1.ServicePort{
				{
					Port:       8080,
					TargetPort: intstr.FromInt(8080),
				},
			},
			Selector: labels, // Internally handled selector
			Type:     corev1.ServiceTypeClusterIP,
		},
	}
}

func (r *KubesharkReconciler) createHubIngress(cr *kubesharkv1beta1.Kubeshark, labels map[string]string) *networkingv1.Ingress {
	return &networkingv1.Ingress{
		ObjectMeta: ctrl.ObjectMeta{
			Name:      "kubeshark-hub-ingress",
			Namespace: cr.Namespace,
			Labels:    labels,
		},
		Spec: networkingv1.IngressSpec{
			Rules: []networkingv1.IngressRule{
				{
					Host: cr.Spec.IngressHost,
					IngressRuleValue: networkingv1.IngressRuleValue{
						HTTP: &networkingv1.HTTPIngressRuleValue{
							Paths: []networkingv1.HTTPIngressPath{
								{
									Path: "/",
									Backend: networkingv1.IngressBackend{
										Service: &networkingv1.IngressServiceBackend{
											Name: getOrDefaultString(cr.Spec.HubServiceName, "kubeshark-hub-service"),
											Port: networkingv1.ServiceBackendPort{
												Number: 80,
											},
										},
									},
								},
							},
						},
					},
				},
			},
		},
	}
}

// Utility functions to handle default values
func getOrDefaultString(value, defaultValue string) string {
	if value == "" {
		return defaultValue
	}
	return value
}

func getOrDefaultInt(value, defaultValue int32) *int32 {
	if value == 0 {
		return &defaultValue
	}
	return &value
}

// SetupWithManager sets up the controller with the Manager.
func (r *KubesharkReconciler) SetupWithManager(mgr ctrl.Manager) error {
	return ctrl.NewControllerManagedBy(mgr).
		For(&kubesharkv1beta1.Kubeshark{}).
		Owns(&appsv1.Deployment{}).
		Owns(&corev1.Service{}).
		Owns(&networkingv1.Ingress{}).
		Complete(r)
}
