package controller

import (
	"context"

	kubesharkv1beta1 "kubeshark-operator/api/v1beta1"

	"github.com/go-logr/logr"
	appsv1 "k8s.io/api/apps/v1"
	corev1 "k8s.io/api/core/v1"
	networkingv1 "k8s.io/api/networking/v1"
	rbacv1 "k8s.io/api/rbac/v1"
	"k8s.io/apimachinery/pkg/api/errors"
	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
	"k8s.io/apimachinery/pkg/runtime"
	"k8s.io/apimachinery/pkg/util/intstr"
	"k8s.io/utils/pointer"
	ctrl "sigs.k8s.io/controller-runtime"
	"sigs.k8s.io/controller-runtime/pkg/client"
)

// KubesharkReconciler reconciles a Kubeshark object
type KubesharkReconciler struct {
	client.Client
	Scheme *runtime.Scheme
	Log    logr.Logger
}

//+kubebuilder:rbac:groups=kubeshark.opstreelabs.in,resources=kubesharks,verbs=get;list;watch;create;update;patch;delete
//+kubebuilder:rbac:groups=kubeshark.opstreelabs.in,resources=kubesharks/status,verbs=get;update;patch
//+kubebuilder:rbac:groups=kubeshark.opstreelabs.in,resources=kubesharks/finalizers,verbs=update

// Reconcile is part of the main Kubernetes reconciliation loop which aims to
// move the current state of the cluster closer to the desired state.
// Reconcile performs the reconciliation loop
func (r *KubesharkReconciler) Reconcile(ctx context.Context, req ctrl.Request) (ctrl.Result, error) {
	r.Log.Info("Reconciling Kubeshark", "namespace", req.Namespace, "name", req.Name)

	// Fetch the Kubeshark instance
	cr := &kubesharkv1beta1.Kubeshark{}
	err := r.Client.Get(ctx, req.NamespacedName, cr)
	if err != nil {
		if errors.IsNotFound(err) {
			r.Log.Info("Kubeshark resource not found. Ignoring since object must be deleted.")
			return ctrl.Result{}, nil
		}
		r.Log.Error(err, "Failed to get Kubeshark")
		return ctrl.Result{}, err
	}

	// Reconcile all components
	err = r.reconcileServiceAccount(ctx, cr, "kubeshark-hub-sa", "kubeshark-hub-sa", map[string]string{"app": "kubeshark"})
	if err != nil {
		return ctrl.Result{}, err
	}

	err = r.reconcileServiceAccount(ctx, cr, "kubeshark-worker-sa", "kubeshark-worker-sa", map[string]string{"app": "kubeshark"})
	if err != nil {
		return ctrl.Result{}, err
	}

	err = r.reconcileConfigMap(ctx, cr, "kubeshark-config", "kubeshark-config", map[string]string{"config": "default"}, map[string]string{"app": "kubeshark"})
	if err != nil {
		return ctrl.Result{}, err
	}

	err = r.reconcileClusterRole(ctx, cr, "kubeshark-cluster-role", "kubeshark-cluster-role", []rbacv1.PolicyRule{}, map[string]string{"app": "kubeshark"})
	if err != nil {
		return ctrl.Result{}, err
	}

	err = r.reconcileDeployment(ctx, cr, "kubeshark-deployment", map[string]string{"app": "kubeshark"})
	if err != nil {
		return ctrl.Result{}, err
	}

	err = r.reconcileService(ctx, cr, "kubeshark-service", map[string]string{"app": "kubeshark"})
	if err != nil {
		return ctrl.Result{}, err
	}

	err = r.reconcileIngress(ctx, cr, "kubeshark-ingress", map[string]string{"app": "kubeshark"})
	if err != nil {
		return ctrl.Result{}, err
	}

	r.Log.Info("Successfully reconciled Kubeshark")
	return ctrl.Result{}, nil
}

// Helper function to reconcile ServiceAccounts
func (r *KubesharkReconciler) reconcileServiceAccount(ctx context.Context, cr *kubesharkv1beta1.Kubeshark, saName, defaultSaName string, labels map[string]string) error {
	sa := &corev1.ServiceAccount{}
	if saName == "" {
		saName = defaultSaName
	}
	err := r.Client.Get(ctx, client.ObjectKey{Name: saName, Namespace: cr.Spec.Namespace}, sa)
	if err != nil {
		if errors.IsNotFound(err) {
			// Create ServiceAccount
			sa = &corev1.ServiceAccount{
				ObjectMeta: metav1.ObjectMeta{
					Name:      saName,
					Namespace: cr.Spec.Namespace,
					Labels:    labels,
				},
			}

			if err := ctrl.SetControllerReference(cr, sa, r.Scheme); err != nil {
				r.Log.Error(err, "Failed to set controller reference", "ServiceAccount", saName)
				return err
			}

			if err := r.Client.Create(ctx, sa); err != nil {
				r.Log.Error(err, "Failed to create ServiceAccount", "ServiceAccount", saName)
				return err
			}
			r.Log.Info("Created ServiceAccount", "ServiceAccount", saName)
		} else {
			return err
		}
	}
	return nil
}

// Helper function to reconcile ConfigMaps
func (r *KubesharkReconciler) reconcileConfigMap(ctx context.Context, cr *kubesharkv1beta1.Kubeshark, configMapName, defaultConfigMapName string, configMapData map[string]string, labels map[string]string) error {
	cm := &corev1.ConfigMap{}
	if configMapName == "" {
		configMapName = defaultConfigMapName
	}
	err := r.Client.Get(ctx, client.ObjectKey{Name: configMapName, Namespace: cr.Spec.Namespace}, cm)
	if err != nil {
		if errors.IsNotFound(err) {
			// Create ConfigMap
			cm = &corev1.ConfigMap{
				ObjectMeta: metav1.ObjectMeta{
					Name:      configMapName,
					Namespace: cr.Spec.Namespace,
					Labels:    labels,
				},
				Data: configMapData,
			}
			if len(cm.Data) == 0 {
				cm.Data = map[string]string{"config": "default-config"} // Default configuration
			}

			if err := ctrl.SetControllerReference(cr, cm, r.Scheme); err != nil {
				r.Log.Error(err, "Failed to set controller reference", "ConfigMap", configMapName)
				return err
			}

			if err := r.Client.Create(ctx, cm); err != nil {
				r.Log.Error(err, "Failed to create ConfigMap", "ConfigMap", configMapName)
				return err
			}
			r.Log.Info("Created ConfigMap", "ConfigMap", configMapName)
		} else {
			return err
		}
	}
	return nil
}

// Helper function to reconcile ClusterRole
func (r *KubesharkReconciler) reconcileClusterRole(ctx context.Context, cr *kubesharkv1beta1.Kubeshark, clusterRoleName, defaultClusterRoleName string, rules []rbacv1.PolicyRule, labels map[string]string) error {
	role := &rbacv1.ClusterRole{}
	if clusterRoleName == "" {
		clusterRoleName = defaultClusterRoleName
	}
	err := r.Client.Get(ctx, client.ObjectKey{Name: clusterRoleName}, role)
	if err != nil {
		if errors.IsNotFound(err) {
			// Create ClusterRole
			role = &rbacv1.ClusterRole{
				ObjectMeta: metav1.ObjectMeta{
					Name:   clusterRoleName,
					Labels: labels,
				},
				Rules: rules,
			}

			if err := ctrl.SetControllerReference(cr, role, r.Scheme); err != nil {
				r.Log.Error(err, "Failed to set controller reference", "ClusterRole", clusterRoleName)
				return err
			}

			if len(role.Rules) == 0 {
				role.Rules = []rbacv1.PolicyRule{
					{APIGroups: []string{""}, Resources: []string{"pods"}, Verbs: []string{"get", "list", "watch"}},
				}
			}
			if err := r.Client.Create(ctx, role); err != nil {
				r.Log.Error(err, "Failed to create ClusterRole", "ClusterRole", clusterRoleName)
				return err
			}
			r.Log.Info("Created ClusterRole", "ClusterRole", clusterRoleName)
		} else {
			return err
		}
	}
	return nil
}

// Helper function to reconcile Deployment
func (r *KubesharkReconciler) reconcileDeployment(ctx context.Context, cr *kubesharkv1beta1.Kubeshark, deploymentName string, labels map[string]string) error {
	deployment := &appsv1.Deployment{}
	err := r.Client.Get(ctx, client.ObjectKey{Name: deploymentName, Namespace: cr.Namespace}, deployment)
	if err != nil {
		if errors.IsNotFound(err) {
			// Create Deployment
			deployment = &appsv1.Deployment{
				ObjectMeta: metav1.ObjectMeta{
					Name:      deploymentName,
					Namespace: cr.Namespace,
					Labels:    labels,
				},
				Spec: appsv1.DeploymentSpec{
					Replicas: pointer.Int32Ptr(1),
					Selector: &metav1.LabelSelector{
						MatchLabels: labels,
					},
					Template: corev1.PodTemplateSpec{
						ObjectMeta: metav1.ObjectMeta{
							Labels: labels,
						},
						Spec: corev1.PodSpec{
							Containers: []corev1.Container{
								{
									Name:  "kubeshark",
									Image: "kubeshark/hub:latest",
									Ports: []corev1.ContainerPort{
										{
											ContainerPort: 8080,
										},
									},
								},
							},
						},
					},
				},
			}

			if err := ctrl.SetControllerReference(cr, deployment, r.Scheme); err != nil {
				r.Log.Error(err, "Failed to set controller reference", "Deployment", deploymentName)
				return err
			}

			if err := r.Client.Create(ctx, deployment); err != nil {
				r.Log.Error(err, "Failed to create Deployment", "Deployment", deploymentName)
				return err
			}
			r.Log.Info("Created Deployment", "Deployment", deploymentName)
		} else {
			return err
		}
	}
	return nil
}

// Helper function to reconcile Service
func (r *KubesharkReconciler) reconcileService(ctx context.Context, cr *kubesharkv1beta1.Kubeshark, serviceName string, labels map[string]string) error {
	service := &corev1.Service{}
	err := r.Client.Get(ctx, client.ObjectKey{Name: serviceName, Namespace: cr.Namespace}, service)
	if err != nil {
		if errors.IsNotFound(err) {
			// Create Service
			service = &corev1.Service{
				ObjectMeta: metav1.ObjectMeta{
					Name:      serviceName,
					Namespace: cr.Namespace,
					Labels:    labels,
				},
				Spec: corev1.ServiceSpec{
					Ports: []corev1.ServicePort{
						{
							Port:       8080,
							TargetPort: intstr.FromInt(8080),
						},
					},
					Selector: labels,
					Type:     corev1.ServiceTypeClusterIP,
				},
			}

			if err := ctrl.SetControllerReference(cr, service, r.Scheme); err != nil {
				r.Log.Error(err, "Failed to set controller reference", "Service", serviceName)
				return err
			}

			if err := r.Client.Create(ctx, service); err != nil {
				r.Log.Error(err, "Failed to create Service", "Service", serviceName)
				return err
			}
			r.Log.Info("Created Service", "Service", serviceName)
		} else {
			return err
		}
	}
	return nil
}

// Helper function to reconcile Ingress
func (r *KubesharkReconciler) reconcileIngress(ctx context.Context, cr *kubesharkv1beta1.Kubeshark, ingressName string, labels map[string]string) error {
	ingress := &networkingv1.Ingress{}
	err := r.Client.Get(ctx, client.ObjectKey{Name: ingressName, Namespace: cr.Namespace}, ingress)
	pathType := networkingv1.PathTypePrefix
	if err != nil {
		if errors.IsNotFound(err) {
			// Create Ingress
			ingress = &networkingv1.Ingress{
				ObjectMeta: metav1.ObjectMeta{
					Name:      ingressName,
					Namespace: cr.Namespace,
					Labels:    labels,
				},
				Spec: networkingv1.IngressSpec{
					Rules: []networkingv1.IngressRule{
						{
							Host: "kubeshark.example.com",
							IngressRuleValue: networkingv1.IngressRuleValue{
								HTTP: &networkingv1.HTTPIngressRuleValue{
									Paths: []networkingv1.HTTPIngressPath{
										{
											Path: "/",
											Backend: networkingv1.IngressBackend{
												Service: &networkingv1.IngressServiceBackend{
													Name: "kubeshark-service",
													Port: networkingv1.ServiceBackendPort{
														Number: 8080,
													},
												},
											},
											PathType: &pathType,
										},
									},
								},
							},
						},
					},
				},
			}

			if err := ctrl.SetControllerReference(cr, ingress, r.Scheme); err != nil {
				r.Log.Error(err, "Failed to set controller reference", "Ingress", ingressName)
				return err
			}

			if err := r.Client.Create(ctx, ingress); err != nil {
				r.Log.Error(err, "Failed to create Ingress", "Ingress", ingressName)
				return err
			}
			r.Log.Info("Created Ingress", "Ingress", ingressName)
		} else {
			return err
		}
	}
	return nil
}

// SetupWithManager sets up the controller with the Manager.
func (r *KubesharkReconciler) SetupWithManager(mgr ctrl.Manager) error {
	return ctrl.NewControllerManagedBy(mgr).
		For(&kubesharkv1beta1.Kubeshark{}).
		Owns(&appsv1.Deployment{}).
		Owns(&corev1.ServiceAccount{}).
		Owns(&corev1.ConfigMap{}).
		Owns(&rbacv1.ClusterRole{}).
		Owns(&corev1.Service{}).
		Owns(&networkingv1.Ingress{}).
		Complete(r)
}
